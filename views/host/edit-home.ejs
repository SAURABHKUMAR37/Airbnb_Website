<%- include('../partials/head') %>

<body class="bg-gradient-to-br from-gray-50 via-white to-red-50 min-h-screen">

    <%- include('../partials/nav') %>

    <main class="container mx-auto px-6 py-10">

        <div class="max-w-4xl mx-auto">

            <!-- Header -->
            <div class="text-center mb-10">

                <div class="w-20 h-20 mx-auto mb-5 flex items-center justify-center bg-red-100 rounded-full text-4xl">
                    🏠
                </div>

                <h1 class="text-5xl font-bold text-gray-900 mb-3">
                    <%= editing ? "Edit Your Home" : "Register Your Home" %>
                </h1>

                <p class="text-lg text-gray-500">
                    List your property and start hosting guests
                </p>

            </div>

            <!-- Form Card -->
            <div class="bg-white rounded-[32px] shadow-xl border border-gray-100 p-8 md:p-10">

                <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST">

                    <input
                        type="hidden"
                        name="id"
                        value="<%= editing ? home._id : '' %>"
                    />

                    <!-- House Name -->
                    <div class="mb-5">

                        <label class="block text-gray-700 font-semibold mb-2">
                            House Name
                        </label>

                        <input
                            type="text"
                            name="houseName"
                            value="<%= editing ? home.houseName : '' %>"
                            placeholder="Enter your house name"
                            class="w-full border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                        >

                    </div>

                    <!-- Price -->
                    <div class="mb-5">

                        <label class="block text-gray-700 font-semibold mb-2">
                            Price Per Night
                        </label>

                        <input
                            type="text"
                            name="price"
                            value="<%= editing ? home.price : '' %>"
                            placeholder="Enter price"
                            class="w-full border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                        >

                    </div>

                    <!-- Location -->
                    <div class="mb-5">

                        <label class="block text-gray-700 font-semibold mb-2">
                            Location
                        </label>

                        <input
                            type="text"
                            name="location"
                            value="<%= editing ? home.location : '' %>"
                            placeholder="Enter location"
                            class="w-full border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                        >

                    </div>

                    <!-- Rating -->
                    <div class="mb-5">

                        <label class="block text-gray-700 font-semibold mb-2">
                            Rating
                        </label>

                        <input
                            type="text"
                            name="rating"
                            value="<%= editing ? home.rating : '' %>"
                            placeholder="Rating"
                            class="w-full border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                        >

                    </div>

                    <!-- Main Photo -->
                    <div class="mb-6">

                        <label class="block text-gray-700 font-semibold mb-2">
                            Main Photo URL
                        </label>

                        <input
                            type="text"
                            name="photoUrl"
                            value="<%= editing ? home.photoUrl : '' %>"
                            placeholder="Main photo URL"
                            class="w-full border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                        >

                    </div>

                    <!-- Additional Photos -->
                    <div class="mb-8">

                        <label class="block text-gray-700 font-semibold mb-3">
                            Gallery Photos
                        </label>

                        <div
                            id="photosContainer"
                            class="space-y-3"
                        >

                            <% if (editing && home.photos && home.photos.length > 0) { %>

                                <% home.photos.forEach((photo, index) => { %>

                                    <div class="flex gap-3">

                                        <input
                                            type="text"
                                            name="photos"
                                            value="<%= photo %>"
                                            placeholder="Photo URL <%= index + 1 %>"
                                            class="flex-1 border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                                        >

                                        <button
                                            type="button"
                                            onclick="removePhoto(this)"
                                            class="bg-red-500 text-white px-4 rounded-2xl hover:bg-red-600 transition">
                                            ✕
                                        </button>

                                    </div>

                                <% }) %>

                            <% } else { %>

                                <div class="flex gap-3">

                                    <input
                                        type="text"
                                        name="photos"
                                        placeholder="Photo URL"
                                        class="flex-1 border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                                    >

                                    <button
                                        type="button"
                                        onclick="removePhoto(this)"
                                        class="bg-red-500 text-white px-4 rounded-2xl hover:bg-red-600 transition">
                                        ✕
                                    </button>

                                </div>

                            <% } %>

                        </div>

                        <!-- Add Photo Button -->
                        <button
                            type="button"
                            onclick="addPhoto()"
                            class="mt-4 bg-blue-500 text-white px-6 py-3 rounded-2xl font-semibold hover:bg-blue-600 transition-all duration-300">
                            + Add Another Photo
                        </button>

                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="w-full bg-red-500 text-white py-4 rounded-2xl font-semibold text-lg shadow-lg hover:bg-red-600 hover:shadow-xl transition-all duration-300">

                        <%= editing ? "Update Home" : "Add Home" %>

                    </button>

                </form>

            </div>

        </div>

    </main>

    <script>
        function addPhoto() {
            const container = document.getElementById('photosContainer');

            const div = document.createElement('div');

            div.className = 'flex gap-3';

            div.innerHTML = `
                <input
                    type="text"
                    name="photos"
                    placeholder="Photo URL"
                    class="flex-1 border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                >

                <button
                    type="button"
                    onclick="removePhoto(this)"
                    class="bg-red-500 text-white px-4 rounded-2xl hover:bg-red-600 transition">
                    ✕
                </button>
            `;

            container.appendChild(div);
        }

        function removePhoto(btn) {
            btn.parentElement.remove();
        }
    </script>

</body>

</html>