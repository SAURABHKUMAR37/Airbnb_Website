<nav class="container mx-auto px-6 py-4">
  <div class="flex items-center justify-between">

    <!-- LEFT -->
    <div class="w-1/4">
      <a href="/" class="text-red-500 font-bold text-2xl">
        🏠 Airbnb
      </a>
    </div>

    <!-- CENTER -->
    <div class="w-2/4 flex justify-center space-x-6">
      <a href="/homes" class="<%= currentpage ==='Home' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1">
        Homes
      </a>

      <a href="/favourite" class="<%= currentpage ==='favourite' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1">
        Favourite
      </a>

      <a href="/bookings" class="<%= currentpage ==='bookings' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1">
        Bookings
      </a>

      <a href="/host-home-list" class="<%= currentpage ==='host-homes' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1">
        Host Homes
      </a>

      <a href="/host/add-home" class="<%= currentpage ==='addhome' ? 'text-red-500 font-bold border-b-2 border-red-500' : 'text-gray-600 hover:text-red-500' %> pb-1">
        Add Home
      </a>
    </div>

    <!-- RIGHT -->
    <div class="w-1/4 flex justify-end items-center gap-3">

      <% if (locals.sessionUser) { %>

        <span class="font-medium text-gray-700">
          👋 <%= sessionUser.name %>
        </span>

        <form action="/logout" method="POST">
          <button
            class="bg-red-500 text-white px-4 py-2 rounded-xl hover:bg-red-600 transition">
            Logout
          </button>
        </form>

      <% } else { %>

        <a href="/login"
           class="px-4 py-2 rounded-xl border border-gray-300 hover:bg-gray-100">
           Login
        </a>

        <a href="/signup"
           class="bg-red-500 text-white px-4 py-2 rounded-xl hover:bg-red-600 transition">
           Sign Up
        </a>

      <% } %>

    </div>

  </div>
</nav>