<%- include('../partials/head')%>

<body class="bg-gradient-to-br from-gray-50 via-white to-red-50 min-h-screen">

    <%- include('../partials/nav')%>

    <main class="container mx-auto px-6 py-12">

        <div class="max-w-md mx-auto">

            <!-- Reset Password Card -->
            <div class="bg-white rounded-[32px] shadow-xl border border-gray-100 p-8 md:p-10">

                <!-- Header -->
                <div class="text-center mb-8">

                    <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center bg-red-100 rounded-full text-3xl">
                        🔒
                    </div>

                    <h2 class="text-4xl font-bold text-gray-800 mb-2">
                        Reset Password
                    </h2>

                    <p class="text-gray-500">
                        Create a new password for your account
                    </p>

                </div>

                <!-- Error Message -->
                <% if (locals.errorMessage) { %>
                    <div class="bg-red-50 border border-red-200 text-red-600 p-4 rounded-2xl mb-6 text-center">
                        ⚠️ <%= errorMessage %>
                    </div>
                <% } %>

                <!-- Reset Password Form -->
                <form action="/reset-password/<%= token %>" method="POST">

                    <!-- Password -->
                    <div class="mb-6">

                        <label class="block text-gray-700 font-semibold mb-2">
                            New Password
                        </label>

                        <input
                            type="password"
                            name="password"
                            required
                            minlength="6"
                            placeholder="Enter your new password"
                            class="w-full border border-gray-200 rounded-2xl p-4 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-400 transition"
                        >

                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="w-full bg-red-500 text-white py-4 rounded-2xl font-semibold text-lg shadow-lg hover:bg-red-600 hover:shadow-xl transition-all duration-300">
                        Reset Password
                    </button>

                </form>

                <!-- Divider -->
                <div class="flex items-center my-8">

                    <div class="flex-1 h-px bg-gray-200"></div>

                    <span class="px-4 text-sm text-gray-400">
                        OR
                    </span>

                    <div class="flex-1 h-px bg-gray-200"></div>

                </div>

                <!-- Back to Login -->
                <p class="text-center text-gray-600">

                    Remember your password?

                    <a
                        href="/login"
                        class="text-red-500 font-semibold hover:text-red-600 hover:underline ml-1">
                        Login
                    </a>

                </p>

            </div>

        </div>

    </main>

</body>

</html>