<%- include('../partials/head') %>

<body>
<%- include('../partials/nav') %>

<main class="container mx-auto p-8 mt-10">

    <!-- ✅ Search & Filter Form -->
    <div class="bg-white shadow-lg rounded-2xl p-6 mb-8">
        <h2 class="text-2xl font-bold text-gray-800 mb-4">🔍 Search Homes</h2>
        <form action="/homes" method="GET">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

                <!-- Location Search -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Location</label>
                    <input
                        type="text"
                        name="location"
                        placeholder="Search by city..."
                        value="<%= filters.location %>"
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400"
                    >
                </div>

                <!-- Min Price -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Min Price</label>
                    <input
                        type="number"
                        name="minPrice"
                        placeholder="Min Rs."
                        value="<%= filters.minPrice %>"
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400"
                    >
                </div>

                <!-- Max Price -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Max Price</label>
                    <input
                        type="number"
                        name="maxPrice"
                        placeholder="Max Rs."
                        value="<%= filters.maxPrice %>"
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400"
                    >
                </div>

                <!-- Sort -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Sort By</label>
                    <select
                        name="sort"
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400"
                    >
                        <option value="">Default</option>
                        <option value="rating"    <%= filters.sort === 'rating'    ? 'selected' : '' %>>⭐ Top Rated</option>
                        <option value="priceLow"  <%= filters.sort === 'priceLow'  ? 'selected' : '' %>>💰 Price Low to High</option>
                        <option value="priceHigh" <%= filters.sort === 'priceHigh' ? 'selected' : '' %>>💰 Price High to Low</option>
                    </select>
                </div>

            </div>

            <!-- Buttons -->
            <div class="flex gap-4 mt-4">
                <button
                    type="submit"
                    class="bg-red-500 text-white px-6 py-3 rounded-lg font-bold hover:bg-red-600 transition duration-300">
                    Search 🔍
                </button>
                <a href="/homes"
                    class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-bold hover:bg-gray-300 transition duration-300">
                    Clear ✖
                </a>
            </div>

        </form>
    </div>

    <!-- ✅ Results Count -->
    <p class="text-gray-500 mb-4">
        Found <span class="font-bold text-red-500"><%= regesteredhome.length %></span> homes
    </p>

    <!-- ✅ No Results Message -->
    <% if (regesteredhome.length === 0) { %>
        <div class="text-center mt-20">
            <p class="text-gray-400 text-6xl mb-4">🏠</p>
            <p class="text-gray-500 text-xl font-semibold">No homes found!</p>
            <p class="text-gray-400 mt-2">Try different search filters.</p>
            <a href="/homes" class="inline-block mt-6 bg-red-500 text-white px-6 py-3 rounded-lg font-bold hover:bg-red-600 transition duration-300">
                Clear Filters
            </a>
        </div>
    <% } else { %>

        <!-- Home Cards -->
        <div class="flex flex-wrap gap-6 justify-center">
            <% regesteredhome.forEach(home => { %>
                <div class="w-80 bg-white rounded-lg shadow-lg overflow-hidden">

                    <img 
    src="<%= home.photos && home.photos.length > 0 ? home.photos[0] : home.photoUrl %>" 
    alt="<%= home.houseName %>"
    class="w-full h-52 object-cover"
>

                    <div class="p-4">
                        <h3 class="text-xl font-bold"><%= home.houseName %></h3>
                        <p class="text-gray-600"><%= home.location %></p>

                        <div class="flex justify-between items-center mt-2">
                            <span class="text-red-500 font-bold">Rs <%= home.price %> / night</span>
                            <span>⭐ <%= home.rating %></span>
                        </div>

                        <a href="/homes/<%= home._id %>"
    style="display:inline-block;background-color:black;color:red;padding:8px 16px;border-radius:6px;text-decoration:none;margin-top:10px;margin-bottom:8px;font-weight:bold;">
    Details
</a>

                        <%- include('../partials/favourite', {home: home}) %>
                    </div>

                </div>
            <% }) %>
        </div>

    <% } %>

</main>

</body>
</html>