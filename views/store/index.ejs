<%- include('../partials/head')%>

<body class="bg-gray-50">

    <%- include('../partials/nav')%>

    <main class="container mx-auto px-6 py-10">

        <!-- Heading -->
        <h2 class="text-4xl md:text-5xl font-bold text-center text-gray-800 mb-12">
            Explore Amazing Homes
        </h2>

        <!-- Homes Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

            <% regesteredhome.forEach(home => { %>

                <div class="bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">

                    <!-- Image -->
                    <div class="overflow-hidden">
                        <img
                            src="<%= home.photos && home.photos.length > 0 ? home.photos[0] : home.photoUrl %>"
                            alt="<%= home.houseName %>"
                            class="w-full h-56 object-cover hover:scale-105 transition duration-500"
                        >
                    </div>

                    <!-- Card Content -->
                    <div class="p-5">

                        <h3 class="text-lg font-semibold text-gray-800 truncate">
                            <%= home.houseName %>
                        </h3>

                        <p class="text-gray-500 text-sm mt-1">
                            📍 <%= home.location %>
                        </p>

                        <div class="flex justify-between items-center mt-3">

                            <span class="text-red-500 font-bold text-lg">
                                ₹<%= home.price %>
                                <span class="text-gray-500 text-sm font-normal">
                                    / night
                                </span>
                            </span>

                            <span class="font-medium text-gray-700">
                                ⭐ <%= home.rating %>
                            </span>

                        </div>

                        <div class="flex gap-3 mt-5">

                            <a href="/homes/<%= home._id %>"
                               class="flex-1 text-center bg-gray-900 text-white py-2.5 rounded-xl hover:bg-black transition">
                                Details
                            </a>

                            <a href="/reserve/<%= home._id %>"
                               class="flex-1 text-center bg-red-500 text-white py-2.5 rounded-xl hover:bg-red-600 transition">
                                Book
                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </main>

</body>
</html>